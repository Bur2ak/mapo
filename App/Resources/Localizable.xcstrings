    "Bağladıktan sonra ajanı yeniden başlat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart the agent after connecting."
          }
        }
      }
    },
    "Bağlanan ajan haritayı sorgulayabilir: \"bunu kim çağırıyor\", \"bu dosya neye bağlı\", \"bu değişirse ne etkilenir\". Salt okunur; kod hiçbir yere gönderilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A connected agent can ask the map \"who calls this\", \"what does this file depend on\", \"what's affected if this changes\". Read-only; your code is never sent anywhere."
          }
        }
      }
    },
    "Bağlantı sayısı": {
