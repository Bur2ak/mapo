              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "If this changes, %lld places may be affected."
                }
              }
            }
          }
        }
      }
    },
    "Bu değişirse nelerin etkilenebileceğini haritada göster": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show on the map what may be affected if this changes"
          }
        }
      }
    },
    "Bu iki dosya arasındaki çağrı ve içe aktarma sayısı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of calls and imports between these two files"
          }
        }
      }
    },
    "Bu ikisi arasında bağlantı zinciri yok: biri diğerini hiçbir yoldan kullanmıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no chain between these two: neither uses the other in any way."
          }
        }
      }
    },
    "Bu konumda zaten bir klasör var: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's already a folder at this location: %@"
          }
        }
      }
    },
    "Bu proje zaten kütüphanede.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project is already in the library."
