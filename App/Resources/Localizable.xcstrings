    "Bölgeler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Areas"
          }
        }
      }
    },
    "Claude Code, Codex, Cursor ya da Claude Desktop'ı Ayarlar › Entegrasyonlar'dan tek tıkla bağla. Ajanın \"bunu kim çağırıyor\", \"bu değişirse ne bozulur\" sorularını haritaya sorar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect Claude Code, Codex, Cursor or Claude Desktop in one click from Settings › Integrations. Your agent then asks the map \"who calls this\" and \"what breaks if this changes\"."
          }
        }
      }
    },
    "Daha az göster": {
